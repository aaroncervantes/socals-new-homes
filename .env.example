# Durable database. In production, use the Railway Postgres connection string.
# When this is unset, leads are stored in SQLite (see SQLITE_PATH).
DATABASE_URL=

# SQLite file used only when DATABASE_URL is unset. Default: data/leads.sqlite
SQLITE_PATH=

# Owner notification. All three must be set or email is skipped.
# The supported provider is Resend. EMAIL_API_KEY is a Resend API key.
# EMAIL_FROM must be a sender verified in that Resend account.
LEAD_NOTIFICATION_EMAIL=
EMAIL_API_KEY=
EMAIL_FROM=

# GoHighLevel. Optional. Submissions succeed when these are blank.
# If GHL_WEBHOOK_URL is an https URL, the lead is posted there.
# Otherwise, when both GHL_API_KEY and GHL_LOCATION_ID are set, a contact is created.
GHL_WEBHOOK_URL=
GHL_API_KEY=
GHL_LOCATION_ID=

# Canonical site origin, no trailing slash. Set this before the production build.
# Example: https://socalsnewhomes.com
NEXT_PUBLIC_SITE_URL=

# Approved profiles only. HTTPS. Leave blank until the owner supplies them.
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=

# Optional override for the approved mark at /brand/logo.png.
# Root-relative path or HTTPS URL. Leave blank to use the file in public/brand.
NEXT_PUBLIC_LOGO_SRC=

# Optional third-party analytics. Blank keeps first-party funnel events only.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Optional. Defaults: 8 lead posts per IP per hour, 2500ms minimum time-to-submit.
RATE_LIMIT_MAX=
MIN_SUBMIT_MS=
